{
  "name": "assignment",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "dev:up": "pnpm db:up && pnpm db:migrate && next dev",
    "dev:down": "docker compose down",
    "db:up": "docker compose up -d --wait db",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:studio": "drizzle-kit studio",
    "data:convert": "tsx scripts/data-convert.ts",
    "models:sync": "tsx scripts/models-sync.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . && depcruise src",
    "typecheck": "tsc --noEmit",
    "test": "pnpm db:up && pnpm db:migrate && vitest run",
    "test:watch": "vitest",
    "verify": "pnpm lint && pnpm typecheck && pnpm test",
    "graph": "mkdir -p docs/architecture && depcruise src --output-type mermaid > docs/architecture/deps.mmd",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "ai": "^7.0.127",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.50.0",
    "next": "16.3.8",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "dependency-cruiser": "^18.5.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "eslint-plugin-jsdoc": "^65.0.2",
    "jsdom": "^30.1.1",
    "lefthook": "^2.1.16",
    "read-excel-file": "^9.3.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.28.0"
}
