# OpenRouter API key. Server-side only, never shipped to the browser. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Postgres connection. When unset or empty, the docker-compose.yml database
# below is used. On Vercel use the Supabase transaction-pooler string (port 6543).
DATABASE_URL=postgres://app:app@localhost:5432/event_intel

# How the LLM gateway behaves:
#   live    call the provider
#   record  call the provider and save the response as a fixture
#   replay  serve fixtures only; needs no key and is what the tests use
LLM_MODE=live
# When LLM_MODE is unset the gateway falls back to replay.
# LLM_FIXTURE_DIR=fixtures/llm   optional; where record writes and replay reads fixtures
